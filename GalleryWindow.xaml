<Window x:Class="PolestarSpain.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Polestar España — Galería de Productos" 
        Height="760" Width="1200" 
        WindowStartupLocation="Manual"
        Background="#F8F8F8" FontFamily="Segoe UI">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="GalleryContent" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- Cabecera Común -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="30,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="GoToHome_Click">
                    <Path Data="M 15,0 L 18,12 L 30,15 L 18,18 L 15,30 L 12,18 L 0,15 L 12,12 Z" 
                          Fill="#101010" Width="26" Height="26" Stretch="Uniform" Margin="0,0,12,0"/>
                    <TextBlock Text="Polestar" FontSize="20" FontWeight="SemiBold" Foreground="#101010" VerticalAlignment="Center"/>
                </StackPanel>

                
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Inicio" Style="{StaticResource NavButtonStyle}" Click="GoToHome_Click"/>
                    <Button Content="Galería de Modelos" Style="{StaticResource ActiveNavButtonStyle}"/>
                    <Button Content="Área de Clientes" Style="{StaticResource NavButtonStyle}" Click="GoToLogin_Click"/>
                </StackPanel>

                <Border Grid.Column="2" Background="#F2F2F2" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock Text="ES | Concesionario Oficial" FontSize="12" Foreground="#555555" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        
        <ScrollViewer x:Name="GalleryContent" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30">
                <Grid Margin="10,0,10,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Galería de Productos Polestar" FontSize="26" FontWeight="Light" Foreground="#101010"/>
                        <TextBlock Text="Visualiza toda la gama de vehículos eléctricos disponibles para el mercado español." FontSize="13" Foreground="#666666" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Filtrar por carrocería:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#555555" FontSize="13"/>
                        <ComboBox x:Name="CmbFilter" Width="180" Padding="8,6" SelectedIndex="0" SelectionChanged="CmbFilter_SelectionChanged">
                            <ComboBoxItem Content="Todos los vehículos (4)"/>
                            <ComboBoxItem Content="Fastback / GT (Polestar 2 y 5)"/>
                            <ComboBoxItem Content="SUV Eléctricos (Polestar 3 y 4)"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <UniformGrid Columns="2">
                    
                    <Border x:Name="CardP2" Style="{StaticResource CarCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F0F0F0" Padding="15">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="02" FontSize="40" FontWeight="Light" Foreground="#BBBBBB" Height="48"/>
                                    <TextBlock Text="FASTBACK" FontSize="11" FontWeight="Bold" Foreground="#555555"/>
                                    <Image Height="69" Source="/Polestar 2 modelo 2.png" Stretch="Fill" Width="122"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                <TextBlock Text="Polestar 2" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Berlina 100% eléctrico con sistema Google integrado." Foreground="#666666" FontSize="12" Margin="0,2,0,10"/>
                                <TextBlock Text="• Autonomía: Hasta 655 km WLTP" FontSize="12" Margin="0,2"/>
                                <TextBlock Text="• Potencia: 350 kW (476 CV)" FontSize="12" Margin="0,2,0,12"/>
                                <Grid>
                                    <TextBlock Text="Desde 42.900 €" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Content="Solicitar Stock" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Padding="14,8" Click="SelectCar_Click" Tag="Polestar 2"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    
                    <Border x:Name="CardP3" Style="{StaticResource CarCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F0F0F0" Padding="15">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="03" FontSize="40" FontWeight="Light" Foreground="#BBBBBB" Height="51"/>
                                    <TextBlock Text="SUV" FontSize="11" FontWeight="Bold" Foreground="#555555"/>
                                    <Image Height="81" Source="/Polestar 3 Modelo 2.png" Stretch="Fill" Width="126"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                <TextBlock Text="Polestar 3" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="SUV de alto rendimiento con sensores LiDAR autónomos." Foreground="#666666" FontSize="12" Margin="0,2,0,10"/>
                                <TextBlock Text="• Autonomía: Hasta 631 km WLTP" FontSize="12" Margin="0,2"/>
                                <TextBlock Text="• Potencia: 380 kW (517 CV)" FontSize="12" Margin="0,2,0,12"/>
                                <Grid>
                                    <TextBlock Text="Desde 88.900 €" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Content="Solicitar Stock" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Padding="14,8" Click="SelectCar_Click" Tag="Polestar 3"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    
                    <Border x:Name="CardP4" Style="{StaticResource CarCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F0F0F0" Padding="15">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="04" FontSize="40" FontWeight="Light" Foreground="#BBBBBB" Height="47"/>
                                    <TextBlock Text="SUV COUPÉ" FontSize="11" FontWeight="Bold" Foreground="#555555"/>
                                    <Image Height="82" Source="/Polestar 4 modelo 2.png" Stretch="Fill" Width="122"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                <TextBlock Text="Polestar 4" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="SUV Coupé aerodinámico con retrovisor digital HD." Foreground="#666666" FontSize="12" Margin="0,2,0,10"/>
                                <TextBlock Text="• Autonomía: Hasta 620 km WLTP" FontSize="12" Margin="0,2"/>
                                <TextBlock Text="• Potencia: 400 kW (544 CV)" FontSize="12" Margin="0,2,0,12"/>
                                <Grid>
                                    <TextBlock Text="Desde 65.900 €" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Content="Solicitar Stock" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Padding="14,8" Click="SelectCar_Click" Tag="Polestar 4"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    
                    <Border x:Name="CardP5" Style="{StaticResource CarCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F0F0F0" Padding="15">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="05" FontSize="40" FontWeight="Light" Foreground="#BBBBBB" Height="46"/>
                                    <TextBlock Text="GRAN TURISMO" FontSize="11" FontWeight="Bold" Foreground="#555555"/>
                                    <Image Height="86" Source="/Polestar 5 GT modelo 23.png" Stretch="Fill" Width="170"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                <TextBlock Text="Polestar 5 GT" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Gran Turismo de 4 puertas con arquitectura de 800V." Foreground="#666666" FontSize="12" Margin="0,2,0,10"/>
                                <TextBlock Text="• Chasis de aluminio termosoldado" FontSize="12" Margin="0,2"/>
                                <TextBlock Text="• Potencia: 650 kW (884 CV)" FontSize="12" Margin="0,2,0,12"/>
                                <Grid>
                                    <TextBlock Text="Desde 119.000 €" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Content="Reservar Cupo" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Padding="14,8" Click="SelectCar_Click" Tag="Polestar 5"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="30,0"/>
    </Grid>
</Window>