<Window x:Class="PolestarSpain.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Polestar España — Identificación y Registro" 
        Height="760" Width="1200" 
        WindowStartupLocation="Manual"
        Background="#F8F8F8" FontFamily="Segoe UI">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="LoginCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- Cabecera Común -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="30,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="GoToHome_Click">
                    <Path Data="M 15,0 L 18,12 L 30,15 L 18,18 L 15,30 L 12,18 L 0,15 L 12,12 Z" 
                          Fill="#101010" Width="26" Height="26" Stretch="Uniform" Margin="0,0,12,0"/>
                    <TextBlock Text="Polestar" FontSize="20" FontWeight="SemiBold" Foreground="#101010" VerticalAlignment="Center"/>
                </StackPanel>

                
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Inicio" Style="{StaticResource NavButtonStyle}" Click="GoToHome_Click"/>
                    <Button Content="Galería de Modelos" Style="{StaticResource NavButtonStyle}" Click="GoToGallery_Click"/>
                    <Button Content="Área de Clientes" Style="{StaticResource ActiveNavButtonStyle}"/>
                </StackPanel>

                <Border Grid.Column="2" Background="#F2F2F2" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock Text="ES | Concesionario Oficial" FontSize="12" Foreground="#555555" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Formulario de Logueo y Registro -->
        <Grid Grid.Row="1">
            <Border x:Name="LoginCard" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Padding="40,35">
                <StackPanel>
                    <TextBlock Text="POLESTAR ID — ESPAÑA" Foreground="#D49B27" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Acceso y Registro de Clientes" FontSize="22" FontWeight="SemiBold" Foreground="#101010" Margin="0,0,0,8"/>
                    <TextBlock Text="Inicia sesión con tu cuenta existente o regístrate introduciendo un nuevo correo y contraseña." 
                               FontSize="12" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,25"/>

                    <TextBlock Text="Correo electrónico *" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtUsername" Height="38" Padding="10,8" FontSize="13" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,18"/>

                    
                    <TextBlock Text="Contraseña *" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PwdBox" Height="38" Padding="10,8" FontSize="13" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,15"/>

                    
                    <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="#FFEBEE" BorderBrush="#C62828" BorderThickness="1" Padding="12,10" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock x:Name="TxtErrorTitle" Text="Error de identificación" Foreground="#C62828" FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="TxtErrorMessage" Text="Detalle del error." Foreground="#B71C1C" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    
                    <Border x:Name="SuccessBanner" Visibility="Collapsed" Background="#E8F5E9" BorderBrush="#2E7D32" BorderThickness="1" Padding="12,10" Margin="0,0,0,18">
                        <TextBlock x:Name="TxtSuccessMessage" Text="Operación completada." Foreground="#1B5E20" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Iniciar Sesión" Style="{StaticResource PrimaryButtonStyle}" Click="BtnSubmitLogin_Click"/>

                        <Button Grid.Column="2" Content="Registrarme" Style="{StaticResource PrimaryButtonStyle}" 
                                Background="White" Foreground="#101010" BorderBrush="#101010" Click="BtnRegister_Click"/>
                    </Grid>

                    
                </StackPanel>
            </Border>
        </Grid>

        
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="30,0"/>
    </Grid>
</Window>
    